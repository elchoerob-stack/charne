<Project Sdk="Microsoft.NET.Sdk">
  <!-- GoldGuard v3 backtester. Compiles the cBot file so HarmonicMath and ExitMath are
       the bot's own code. See README.md for how to run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AlgoBuild>false</AlgoBuild>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GoldGuard_XAUUSD_v3.cs" />
    <Compile Include="Backtester.cs" />
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
</Project>
