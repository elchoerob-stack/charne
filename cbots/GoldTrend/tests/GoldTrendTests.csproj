<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the cBot against Spotware's cTrader.Automate package (proves it builds),
       runs the TrendMath unit tests, and checks the bot's daily breakout signal against
       the research harness on every day from Sep 2016 to Oct 2026. Run: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AlgoBuild>false</AlgoBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GoldTrend_XAUUSD_D1.cs" />
    <Compile Include="TrendTests.cs" />
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
</Project>
