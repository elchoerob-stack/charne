# Claude API key. With `ant auth login` set up you can leave this unset.
ANTHROPIC_API_KEY=

# Model used for the agent. Opus 5 is the default. The agent relies on
# mid-conversation system messages, which Claude Opus 5 / 4.8 / Fable support
# (Sonnet 5 does not).
ANTHROPIC_MODEL=claude-opus-5

# HTTP port for the agent server and console
PORT=8787

# SQLite file (created on first run)
FOREMAN_DB=./data/foreman.db

# Optional: allow the agent's web_search tool. Set to "off" to disable.
WEB_SEARCH=on

# Optional shared secret. If set, the console and recorder extension must send
# it as `Authorization: Bearer <token>`.
CMS_AGENT_TOKEN=

# Optional: comma-separated Evolve / Infomedia endpoint URLs for live health checks.
# Leave blank to use the built-in simulated adapters.
EVOLVE_HEALTH_URL=
INFOMEDIA_HEALTH_URL=

# ── Case-to-ticket bridge ─────────────────────────────────────────────
# draft (default: packet + mailto link only) | webhook | jira | email
TICKET_CHANNEL=draft
# Public URL of this server, used for recording/SOP links inside tickets
PUBLIC_URL=http://localhost:8787
# webhook: any JSON endpoint (Zapier Catch Hook, Make, Power Automate, helpdesk inbound)
TICKET_WEBHOOK_URL=
# jira: Jira Cloud REST with an API token
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# email: SMTP URL e.g. smtps://user:password@smtp.office365.com:465
SMTP_URL=
TICKET_EMAIL_TO=support@cms.example
TICKET_EMAIL_FROM=
# default team named in packets when the playbook does not say
TICKET_DEFAULT_TO=CMS support desk

# ── Notifier: agent reports to your phone ─────────────────────────────
# Any mix of: ntfy, webhook, email. Leave blank to keep reports in the console only.
NOTIFY_CHANNELS=
# ntfy: install the ntfy app, subscribe to a long random topic, put it here.
# (The Trade Desk uses ntfy too; use a DIFFERENT topic for Foreman.)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# webhook: a Zapier "Catch Hook" URL turns reports into WhatsApp/SMS/Slack/e-mail
NOTIFY_WEBHOOK_URL=
# email: uses SMTP_URL above
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# all (default) | problems — only partial and failed runs
NOTIFY_ON=all
# Good news is silent in this window (Centurion time); problems still make a sound
NOTIFY_QUIET=21:30-06:00

# ── Task runner (record once, replay on its own) ──────────────────────
# Foreman drives a real browser to replay recorded work. You almost certainly
# already have Chrome installed, so point it there and skip a second download:
BROWSER_CHANNEL=chrome
# Or give an explicit path to a browser executable (wins over BROWSER_CHANNEL):
BROWSER_PATH=
# With neither set, run `npx playwright install chromium` once to fetch one.

# ── Remote access (phone on the road) ─────────────────────────────────
# Tailscale is detected automatically — install it on the laptop and phone and
# nothing here needs setting. A Cloudflare tunnel puts Foreman on the public
# internet, so it is refused unless CMS_AGENT_TOKEN above is 20+ characters.
# See docs/REMOTE_ACCESS.md.

# ── Where documents land ──────────────────────────────────────────────
# Anything a task downloads or writes is saved here, in a folder per task and
# run. Point it at your Desktop, OneDrive, or a network share.
# Default: a "Foreman" folder in your home directory.
WORKSPACE_DIR=

# ── Support desk (/support.html) ─────────────────────────────────────────────
# Jira Cloud. Create a token at id.atlassian.com → Security → API tokens.
# Tickets are assigned to whoever owns the token (or set JIRA_ASSIGNEE_ACCOUNT_ID).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# The fields the desk requires on every closed ticket are found in Jira BY NAME,
# so no field ids are needed. These are the defaults; change them only if your
# desk calls them something else.
JIRA_AGENT_FIELD=Support Agent
JIRA_ENQUIRY_FIELD=Support Enquiry
JIRA_GROUP_FIELD=Group and Dealership
# What goes in Support Enquiry.
JIRA_ENQUIRY_VALUE=Product Support
# Optional, only for tickets Foreman itself creates: also tag them on creation.
#   component:Product Support   label:product-support   option:customfield_10042:Value
JIRA_SUPPORT_TAG=
#   component   label   option:customfield_10042   (the group's name is the value)
JIRA_GROUP_TAG=
# Name of the transition that closes a ticket (default Done).
JIRA_DONE_TRANSITION=Done
# Sign-off on drafted replies.
SUPPORT_SIGNATURE=

# ── Shell (/shell.html) ──────────────────────────────────────────────────────
# How many steps may run at once across all jobs. Steps on the same ticket never overlap whatever this is.
SHELL_CONCURRENCY=3
