# Copy to .env and fill in. .env is git-ignored: never commit it, never paste
# these values into a chat.
#
# There are no risk settings here on purpose. Risk limits are constants in
# app/risk_engine.py.

# --- cTrader Open API (https://openapi.ctrader.com/apps) ----------------------
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
# The ctidTraderAccountId of the DEMO account (run: python -m app.main accounts)
CTRADER_ACCOUNT_ID=
# Comma-separated. The bot refuses any account not on this list, and refuses
# any account the server reports as live even if it is on the list.
CTRADER_DEMO_ACCOUNT_ALLOWLIST=
# Only if your broker calls gold something other than XAUUSD
CTRADER_SYMBOL_NAME=XAUUSD

# --- AI providers -------------------------------------------------------------
OPENAI_API_KEY=
# No default. Pick a GPT-6 model ID from OpenAI's model list, e.g. gpt-6-astra
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60

# Optional: list prices (USD per 1M tokens) so `report` can show API spend
OPENAI_USD_PER_MTOK_IN=
OPENAI_USD_PER_MTOK_OUT=
ANTHROPIC_USD_PER_MTOK_IN=
ANTHROPIC_USD_PER_MTOK_OUT=

# --- Storage and alerts -------------------------------------------------------
DATA_DIR=data
# Phone alerts, same as Foreman: ntfy topic and/or a webhook (e.g. Zapier Catch Hook)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
NOTIFY_WEBHOOK_URL=
