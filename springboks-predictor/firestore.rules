rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Springboks Tour Predictor: one collection, nothing else.
    match /matches/{matchId} {
      allow read: if true;
      // New games only, and only ones tagged for this app.
      allow create: if request.resource.data.app == "cms";
      // Players add picks and the organiser adds results: nothing else changes.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["p", "f"]);
      allow delete: if false;
    }
  }
}
