PORT=4000

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Desktop app)
# Enable the Calendar API and Gmail API on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/callback

# Produced by `npm run google:auth` (see scripts/google-oauth.ts)
GOOGLE_REFRESH_TOKEN=
